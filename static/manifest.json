{
  "manifest_version": 3,
  "name": "Поля",
  "short_name": "Поля",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Личные заметки к тексту и изображениям. Сохраняйте комментарии в локальном журнале.",
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab"],
  "background": { "service_worker": "worker.js" },
  "action": {
    "default_title": "Открыть «Поля»",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "css": ["theme.css", "highlight.css"],
    "run_at": "document_start"
  }]
}
