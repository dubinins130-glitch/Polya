{
  "name": "polya-fields",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "playwright-core": "^1.58.2",
    "typescript": "~5.9.3"
  }
}
